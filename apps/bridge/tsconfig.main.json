{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@capture/shared": ["../../packages/shared/src/index.ts"],
      "@capture/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/main/**/*", "src/shared/**/*", "../../packages/shared/src/**/*"],
  "exclude": ["src/renderer/**/*", "node_modules", "dist"]
}
