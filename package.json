{
  "name": "mote-capture",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:cloud": "pnpm --filter cloud dev",
    "dev:bridge": "pnpm --filter bridge dev",
    "build": "turbo run build",
    "build:bridge": "pnpm --filter bridge build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm --filter @capture/db migrate",
    "db:generate": "pnpm --filter @capture/db generate",
    "package:bridge:mac": "pnpm --filter bridge package:mac",
    "package:bridge:win": "pnpm --filter bridge package:win",
    "package:bridge:linux": "pnpm --filter bridge package:linux",
    "build:installer:windows": "node scripts/build-installer.js"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0-rc-66855b96-20241106",
      "react-dom": "19.0.0-rc-66855b96-20241106"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "*",
        "react-dom": "*"
      }
    }
  }
}
