[Unit]
Description=Mote Capture kiosk (cage + Chromium, layar penuh)
After=booth-agent.service systemd-user-sessions.service
Wants=booth-agent.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=booth
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
EnvironmentFile=/etc/booth-agent/env
# Tunggu agent sehat sebelum membuka browser (hindari layar error saat boot).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -fsS --max-time 2 http://127.0.0.1:7777/health >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStart=/bin/sh -c 'exec /usr/bin/cage -d -s -- /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --no-first-run --disable-translate --disable-features=Translate,TouchpadOverscrollHistoryNavigation --overscroll-history-navigation=0 --disable-pinch --check-for-update-interval=31536000 --password-store=basic --autoplay-policy=no-user-gesture-required "http://127.0.0.1:7777/kiosk/${BOOTH_ID}"'
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
