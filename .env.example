# === DATABASE (reuse mote-pg via Docker local) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mote

# === REDIS (reuse mote-redis via Docker local) ===
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=capture:

# === ADMIN AUTH (plain, no hash) ===
ADMIN_EMAIL=smnanan@motekreatif.com
ADMIN_PASSWORD=changeme123

# === SESSION SIGNING ===
BETTER_AUTH_SECRET=replace-with-random-32-char-string-here

# === APP ===
NEXT_PUBLIC_APP_URL=http://localhost:5000
NODE_ENV=development
PORT=5000

# === CLOUDFLARE R2 (Storage) — kosongkan untuk mock mode (file disimpan ke public/uploads) ===
R2_ACCOUNT_ID=5a4728efc7ef4e9ef576ba275d74fee0
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=mote-capture-prod
R2_ENDPOINT=https://5a4728efc7ef4e9ef576ba275d74fee0.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://mote-capture-prod.r2.dev

# === XENDIT (Payment) — kosongkan untuk mock mode (QR string MOCK_*) ===
XENDIT_SECRET_KEY=xnd_production_replace_me
XENDIT_WEBHOOK_TOKEN=replace-with-webhook-token
XENDIT_QR_AMOUNT_CURRENCY=IDR

# === EVOLUTION API (WhatsApp) — kosongkan untuk mock mode (log "would send") ===
EVOLUTION_API_URL=https://nndlwn-wa-evolution-api.85c4o8.easypanel.host
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_INSTANCE_NAME=capture

# === EMAIL (Gmail SMTP) — kosongkan untuk mock mode ===
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=replace-with-gmail-address
EMAIL_PASSWORD=replace-with-app-password-no-spaces
EMAIL_FROM_NAME=Mote Capture

# === DOWNLOAD ===
DOWNLOAD_LINK_EXPIRY_DAYS=7

# === PAYMENT DEFAULTS ===
PAYMENT_DEFAULT_PROVIDER=xendit
