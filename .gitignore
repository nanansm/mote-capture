# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
.turbo/
.wrangler/
dist/
build/
out/
*.tsbuildinfo

# graphify knowledge graph (regenerated from source by the post-commit hook)
graphify-out/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Uploads (runtime files, keep folder via .gitkeep)
apps/cloud/public/uploads/*
!apps/cloud/public/uploads/.gitkeep
!apps/cloud/public/uploads/*/
apps/cloud/public/uploads/**/*
!apps/cloud/public/uploads/**/.gitkeep

# Next standalone build artifacts
.next/cache/

# Bridge electron-builder outputs
apps/bridge/dist/
apps/bridge/dist-installer/

# Bridge generated icons (auto-generated by assets/generate-icons.cjs)
apps/bridge/assets/*.png
!apps/bridge/assets/.gitkeep

# Inno Setup installer build artifacts (regenerated by build-installer scripts)
apps/bridge/installer/output/*.exe
apps/bridge/installer/assets/installer-icon.ico
apps/bridge/installer/assets/installer-banner.bmp
apps/bridge/installer/assets/installer-small.bmp
